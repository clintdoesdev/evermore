# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/evermore?schema=public"

# Random secret used to sign admin/member session JWTs.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Used ONLY by `npm run db:seed` to create the initial admin account.
# Set these, run the seed once, then remove them from your environment.
ADMIN_SEED_USERNAME=""
ADMIN_SEED_PASSWORD=""
